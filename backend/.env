# Variables de entorno para configuración segura (No hardcodear secretos)
DATABASE_URL=sqlite:///./nutriapp.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth2 — Client ID de tu proyecto en Google Cloud Console
# Si está vacío, se omite la validación de audiencia (útil en desarrollo local)
GOOGLE_CLIENT_ID=
