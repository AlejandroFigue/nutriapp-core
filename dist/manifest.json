  "shortcuts": [
    {
      "name": "Registrar Comida",
      "short_name": "Registrar",
      "description": "Agrega una ingesta al diario del día",
      "url": "/registrar",
      "icons": [
        { "src": "/icons/shortcut-registrar.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Mi Progreso",
      "short_name": "Progreso",
      "description": "Revisa tu historial y evolución nutricional",
      "url": "/progreso",
      "icons": [
        { "src": "/icons/shortcut-progreso.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Buscar Alimento",
      "short_name": "Buscar",
      "description": "Consulta la base de datos de alimentos",
      "url": "/buscar",
      "icons": [
        { "src": "/icons/shortcut-buscar.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Plan del Día",
      "short_name": "Plan",
      "description": "Visualiza y ajusta tu plan nutricional de hoy",
      "url": "/plan",
      "icons": [
        { "src": "/icons/shortcut-plan.png", "sizes": "96x96", "type": "image/png" }
      ]
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/dashboard-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard nutricional"
    },
    {
      "src": "/screenshots/registrar-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Registro de comidas"
    },
    {
      "src": "/screenshots/dashboard-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Vista de escritorio"
    }
  ],

  "related_applications": [],

  "protocol_handlers": [
    {
      "protocol": "web+nutriapp",
      "url": "/share?data=%s"
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  }
}
