{
  "name": "NutriApp Profesional",
  "short_name": "NutriApp",
  "description": "Gestión nutricional personalizada. Registra comidas, controla macros y sigue tu progreso sin conexión.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "lang": "es-AR",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#2E7D32",
  "background_color": "#FAFAFA",
  "categories": ["health", "fitness", "food"],
  "prefer_related_applications": false,

  "icons": [
    {
